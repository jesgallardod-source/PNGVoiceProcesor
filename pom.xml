<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.PNGV</groupId>
    <artifactId>PNGVoice</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>PNGVoice</name>
    <description>App local tipo Veadotube: avatar PNG que reacciona al volumen de la voz y a las sílabas/fonemas pronunciados.</description>

    <properties>
        <!-- Usar `release` en vez de source+target para evitar warnings del compilador
             y garantizar compatibilidad con los system modules de JDK 21. -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21.0.4</javafx.version>
        <jackson.version>2.17.2</jackson.version>
        <slf4j.version>2.0.16</slf4j.version>
        <logback.version>1.5.8</logback.version>
        <junit.version>5.11.3</junit.version>
        <mockito.version>5.14.2</mockito.version>

        <!-- ===== Generación de instalador / .exe (jpackage) ===== -->
        <!-- Tipo de salida de jpackage (org.panteleyev.jpackage.ImageType, enum en MAYÚSCULAS).
             Opciones válidas: APP_IMAGE (carpeta con PNGVoice.exe, recomendado, no requiere WiX),
             EXE / MSI (instalador, requieren WiX en Windows), DMG/PKG (macOS), DEB / RPM (Linux).
             NO usar "app-image" (con guion/minúsculas): Maven no lo convierte al enum. -->
        <jpackage.type>APP_IMAGE</jpackage.type>
        <!-- Pasa a true para omitir la generación del .exe (p. ej. en CI o builds rápidos). -->
        <skip.jpackage>false</skip.jpackage>
        <!-- Versión de la app para jpackage (debe ser numérica: X.Y.Z, no "1.0-SNAPSHOT"). -->
        <jpackage.appVersion>1.0.0</jpackage.appVersion>
        <!-- Carpeta donde se deposita el resultado (PNGVoice.exe / instalador). -->
        <jpackage.destination>dist</jpackage.destination>
    </properties>

    <dependencies>
        <!-- ===== UI: JavaFX ===== -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- ===== DSP: análisis de audio / FFT / RMS ===== -->
        <dependency>
            <groupId>com.github.wendykierp</groupId>
            <artifactId>JTransforms</artifactId>
            <version>3.2</version>
            <!-- JTransforms → JLargeArrays trae junit4 como dep. de compile.
                 No se necesita en producción → excluir para no inflar el fat-jar. -->
            <exclusions>
                <exclusion>
                    <groupId>junit</groupId>
                    <artifactId>junit</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.hamcrest</groupId>
                    <artifactId>hamcrest-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- ===== ASR local: Vosk (español) ===== -->
        <dependency>
            <groupId>com.alphacephei</groupId>
            <artifactId>vosk</artifactId>
            <version>0.3.45</version>
        </dependency>

        <!-- ===== Config / JSON ===== -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- ===== Logging ===== -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>

        <!-- ===== Testing ===== -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compilador -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!-- Surefire para JUnit 5 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.1</version>
            </plugin>

            <!-- JavaFX: empaquetado y ejecución -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>org.PNGV.app.PngVoiceApp</mainClass>
                </configuration>
            </plugin>

            <!-- Empaquetado: jar ejecutable con dependencias -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>org.PNGV.Main</mainClass>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- Shade: fat-jar con dependencias (para jpackage / ejecución sencilla) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.PNGV.Main</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Limpiar la carpeta destino de jpackage ANTES de que se ejecute,
                 porque jpackage NO puede sobrescribir una carpeta existente.
                 Se ejecuta en prepare-package (justo antes de package). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>clean-jpackage-dest</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete dir="${jpackage.destination}/PNGVoice" quiet="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- jpackage: genera el .exe (o instalador) autocontenido con su propio JRE.
                 Usa jpackage del JDK (requiere JDK 14+). Se ejecuta en la fase `package`,
                 después del fat-jar de shade, usando ese jar como entrada.
                 Salida por defecto: dist/PNGVoice/PNGVoice.exe (tipo app-image). -->
            <plugin>
                <groupId>org.panteleyev</groupId>
                <artifactId>jpackage-maven-plugin</artifactId>
                <version>1.6.6</version>
                <configuration>
                    <name>PNGVoice</name>
                    <appVersion>${jpackage.appVersion}</appVersion>
                    <!-- Carpeta con el fat-jar (mainJar). jpackage lo necesita como input
                         para apps no modulares; sin él falla al no encontrar el jar. -->
                    <input>${project.build.directory}</input>
                    <vendor>org.PNGV</vendor>
                    <description>Avatar PNG que reacciona al volumen de la voz y a los fonemas pronunciados.</description>
                    <mainJar>PNGVoice-${project.version}.jar</mainJar>
                    <mainClass>org.PNGV.Main</mainClass>
                    <type>${jpackage.type}</type>
                    <destination>${jpackage.destination}</destination>
                    <!-- JavaFX: las dependencias org.openjfx ya están en el fat-jar,
                         así que jpackage solo necesita la main class. -->
                    <javaOptions>
                        <option>-Xmx1g</option>
                    </javaOptions>
                </configuration>
                <executions>
                    <execution>
                        <id>create-app-image</id>
                        <phase>package</phase>
                        <goals>
                            <goal>
                                jpackage
                            </goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
